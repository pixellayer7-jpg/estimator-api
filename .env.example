# HTTP port (default 3000)
PORT=3000

# Comma-separated allowed origins for CORS, e.g. https://pixellayer7-jpg.github.io
# Leave empty to allow all (dev only).
CORS_ORIGIN=

# Directory for quote JSON store (default ./data inside project)
DATA_DIR=

# Optional bearer token for GET /api/v1/quotes list endpoint.
# When set, list requests must send: Authorization: Bearer <token>
# Single quote GET /api/v1/quotes/:id remains public for share links.
LIST_QUOTES_TOKEN=

# Public frontend URLs for share links in POST /api/v1/quotes responses
FRONTEND_CALCULATOR_URL=https://pixellayer7-jpg.github.io/project-estimator/
FRONTEND_LANDING_URL=https://pixellayer7-jpg.github.io/1/
