# HTTP port (default 3000)
PORT=3000

# Comma-separated allowed origins for CORS, e.g. https://pixellayer7-jpg.github.io
# Leave empty to allow all (dev only).
CORS_ORIGIN=

# Directory for SQLite DB (estimator.sqlite) and optional legacy JSON import (default ./data)
DATA_DIR=

# Optional PostgreSQL URL. When set, the API uses Postgres instead of SQLite (multi-instance ready).
# Example: postgres://estimator:estimator@127.0.0.1:5432/estimator
# DATABASE_URL=

# Legacy admin bearer (list + PATCH + backup). When set (or API_TOKENS),
# protected routes need Authorization: Bearer <token>.
# Single quote GET /api/v1/quotes/:id remains public for share links.
# Backup always requires an admin token (503 if none configured).
LIST_QUOTES_TOKEN=

# Multi-role tokens (optional). Formats:
#   admin:adm-secret,crm:crm-secret,readonly:ro-secret
#   [{"role":"admin","token":"..."},{"role":"crm","token":"..."}]
# Roles: admin (list+write+backup), crm (list+write), readonly (list).
# API_TOKENS=

# Public frontend URLs for share links in POST /api/v1/quotes responses
FRONTEND_CALCULATOR_URL=https://pixellayer7-jpg.github.io/project-estimator/
FRONTEND_LANDING_URL=https://pixellayer7-jpg.github.io/1/
